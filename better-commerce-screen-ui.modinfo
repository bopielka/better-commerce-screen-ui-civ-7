<?xml version="1.0" encoding="utf-8"?>
<!--
    version on <Mod> must be an integer >= 1. It is parsed as an int, so version="0.1"
    lands in Mods.sqlite as Version 0 and the game then silently refuses to apply the
    mod: it is discovered, it shows as enabled in the Mods menu, and it never appears
    in Modding.log's "enabled mods" list. The human-readable version lives in
    <Properties><Version> below, which is a free-form string.
-->
<Mod id="better-commerce-screen-ui" version="1"
    xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_NAJANE_COMMERCE_NAME</Name>
        <Version>0.1</Version>
        <Description>LOC_MOD_NAJANE_COMMERCE_DESCRIPTION</Description>
        <Authors>Najane</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <ShowInBrowser>1</ShowInBrowser>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="najane-commerce-ui" scope="game" criteria="always">
            <Properties>
                <!-- Above Resource+ (1100) so its wrapper is already registered when
                     this mod captures the factory it delegates to. The priority is
                     computed at runtime as well, so this is belt and braces. -->
                <LoadOrder>1200</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/InGameText.xml</Item>
                    <Item locale="pl_PL">text/pl_PL/InGameText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/options/najane-commerce-options.js</Item>
                    <Item>ui/better-commerce-screen-ui.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <!--
            The options screen exists in the main menu as well as in game, so the options
            module has to be registered in both scopes or the checkbox disappears from one
            of them. Nothing else belongs in the shell.
        -->
        <ActionGroup id="najane-commerce-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>1200</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/InGameText.xml</Item>
                    <Item locale="pl_PL">text/pl_PL/InGameText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/options/najane-commerce-options.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModInfoText.xml</File>
        <File>text/pl_PL/ModInfoText.xml</File>
    </LocalizedText>
</Mod>
